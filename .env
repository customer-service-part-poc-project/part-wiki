# 텔레그램 수집 자격증명 — scripts/fetch_telegram.py 가 읽는다.
# 발급처: https://my.telegram.org > API development tools
# 앱 제목: 고객서비스파트방 · 짧은 이름: customerpart

TELEGRAM_API_ID=38185115
TELEGRAM_API_HASH=3cf92b429d37b76beab65564359fde1e

# 동기화할 방. 쉼표로 구분한다.
# --add-chat 으로 등록한 목록과 합쳐지므로 둘 중 아무거나 써도 된다.
TELEGRAM_CHATS=고객서비스파트,우리팀,평생보장소득

# 공지만 받는 방. 입·퇴장 같은 멤버 기록은 저장하지 않는다.
# 파트 위 조직 방은 팀 일정·상황만 알면 되고, 거기 멤버는 우리 데이터가 아니다.
TELEGRAM_NOTICE_ONLY=우리팀
